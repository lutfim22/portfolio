# No environment variables or credentials are required for local development.
# Never prefix secrets with NEXT_PUBLIC_: those values are exposed to browsers.

# Set to the verified production HTTPS origin before a deployment build.
# No guessed Vercel domain or preview URL is used as a fallback.
# SITE_URL=https://your-verified-domain.example
# Enable indexing only after approval to launch. Previews remain noindex.
SITE_INDEXABLE=false

# Independent opt-ins: active only on an indexable Vercel production build.
# Keep disabled until provider setup, disclosure review, and launch approval.
SITE_ANALYTICS=false
SITE_SPEED_INSIGHTS=false
# Runtime setting: emits only an error category and validated framework digest.
SERVER_ERROR_LOGGING=false
